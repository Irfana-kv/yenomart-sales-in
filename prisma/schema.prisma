model ShipmentData {
  id          Int     @id @default(autoincrement())
  client_name String?

  // PRODUCT INFO
  product_name String?
  category     String?
  material     String?

  // PRODUCT DIMENSIONS (PER PIECE)
  length_cm Float?
  width_cm  Float?
  height_cm Float?
  weight_kg Float?

  // PACKING (PER CARTON)
  packing_length_cm Float?
  packing_width_cm  Float?
  packing_height_cm Float?
  carton_type       String? @default("Standard Carton")

  items_per_carton Int @default(1)
  total_cartons    Int @default(1)

  // ✅ DERIVED VALUES (IMPORTANT SPLIT)
  cbm_per_carton Float? // (L×W×H)/1,000,000
  total_cbm      Float? // cbm_per_carton × cartons

  vol_weight_per_carton Float? // (L×W×H)/5000
  total_vol_weight      Float?

  gross_weight_total Float? // actual weight × qty
  chargeable_weight  Float? // MAX(gross, volumetric)

  shipping_mode String? // "AIR" | "SEA" | "COURIER"
  rate_per_kg   Float? // e.g. 500
  shipping_cost Float?

  quantity Int @default(1)

  createdAt DateTime @default(now())
}

