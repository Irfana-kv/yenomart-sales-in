enum ShippingSourceTable {
  PRODUCTSHOP
  PRODUCTDETAIL
  PRODUCT_SKU_LIST
  MANUAL_OVERRIDE
  AI_ESTIMATE
}

model ProductShippingDetail {
  id                      Int                 @id @default(autoincrement())
  
  // Explicit Source Identification
  source_table            ShippingSourceTable @default(PRODUCTSHOP) // Identifies where data came from: PRODUCTSHOP or PRODUCTDETAIL
  
  // Identifiers & Foreign Keys
  offerId                 String?             // 1688 Offer ID (e.g., "743254853265")
  productShopId           String?             // Foreign key to ProductShop.id
  productDetailId         Int?                // Foreign key to ProductDetail.id
  productSkuId            Int?                // Foreign key to ProductSkuList.id (if SKU specific)

  // Package Weight & Dimensions
  weight                  Float?              @default(0.0)
  length                  Float?              @default(0.0)
  width                   Float?              @default(0.0)
  height                  Float?              @default(0.0)
  measurement_type        MeasurementType     @default(GRAM)

  // Official Platform Measurements (from 1688 raw_data.productShippingInfo)
  officialWeight          Float?
  officialLength          Float?
  officialWidth           Float?
  officialHeight          Float?
  pkgSizeSource           String?             // e.g., "商家自填"

  // AI Estimated Weight & Accuracy (from 1688 raw_data.productShippingInfo.skuShippingDetails)
  aiWeight                Float?
  aiWeightAccuracy        String?             // e.g., "80%"

  // Additional Shipping Identifiers & Metadata
  skuId                   String?             // 1688 SKU ID (e.g. "5836357801929")
  specId                  String?             // SKU specId (e.g. "2579a83330f9b87e6c10fc53a17c64c7")
  productCargoNumber      String?             // Cargo/Article Number (e.g. "A13")
  unit                    String?             // Sales Unit (e.g. "Kilogram")
  skuProperties           Json?               // SKU attributes/properties
  price                   Float?              @default(0.0)
  promotionPrice          Float?              @default(0.0)
  quantity                Int?                @default(0)



  // Shipping Charges
  shipping_charge_sea     Float?              @default(0.0)
  shipping_charge_air     Float?              @default(0.0)
  postFee                 Float?              @default(0.0)

  // Logistics Origin
  sendGoodsAddressText    String?             // e.g. "浙江省金华市"
  shippingTimeGuarantee   String?

  // Raw JSON
  skuShippingDetails      Json?
  skuShippingInfoList     Json?

  // Timestamps
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  // Foreign Key Relations
  productShop             ProductShop?        @relation(fields: [productShopId], references: [id], onDelete: Cascade)
  productDetail           ProductDetail?      @relation(fields: [productDetailId], references: [id], onDelete: Cascade)
  productSku              ProductSkuList?     @relation(fields: [productSkuId], references: [id], onDelete: Cascade)

  @@index([source_table])
  @@index([offerId])
  @@index([productShopId])
  @@index([productDetailId])
  @@index([productSkuId])
  @@map("product_shipping_details")
}

